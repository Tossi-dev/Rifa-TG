# =============================================================================
#  Variaveis de ambiente
#  Copie para .env.local (desenvolvimento) ou cadastre na Vercel (producao).
#  Sem nenhuma delas o site roda em MODO DEMONSTRACAO.
# =============================================================================

# Endereco publico do site (usado no webhook do Mercado Pago)
NEXT_PUBLIC_BASE_URL=https://suarifa.com.br

# --- Mercado Pago (Pix automatico) -------------------------------------------
# Painel > Suas integracoes > sua aplicacao > Credenciais de producao
MP_ACCESS_TOKEN=
# Painel > Webhooks > "Chave secreta" (valida a assinatura das notificacoes)
MP_WEBHOOK_SECRET=

# --- Banco de dados (Upstash Redis) ------------------------------------------
# Vercel > Storage > Upstash Redis. OBRIGATORIO em producao: sem isso o app
# guarda tudo na memoria do processo, e na Vercel cada requisicao pode cair numa
# instancia diferente — o pedido some entre o formulario e a tela de pagamento.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Painel do organizador ---------------------------------------------------
# Protege /admin e as rotas /api/admin/*. Sem valor, a area inteira fica off.
# Use um valor longo e aleatorio: e a senha que abre os dados dos compradores.
ADMIN_TOKEN=

# --- Demonstracao em ambiente publicado (deixe vazio) ------------------------
# O botao "Simular pagamento aprovado" e desligado em producao de proposito.
# Preencha com "sim" APENAS para demonstrar um site publicado sem gateway.
PERMITIR_SIMULACAO_EM_PRODUCAO=
